rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['handokokusalaviro@gmail.com'];
    }
    function owner(sid) {
      return signedIn() && get(/databases/$(database)/documents/students/$(sid)).data.ownerUid == request.auth.uid;
    }

    // Class codes: anyone signed in can check a code exists; only admins create them.
    match /classes/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /students/{sid} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classCode));
      // The owner device may update; a restored device may take over if it knows the player's secret.
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (resource.data.ownerUid == request.auth.uid || resource.data.secret == request.resource.data.secret));
      allow delete: if isAdmin();

      match /journal/{id} {
        allow read: if isAdmin();
        allow create, update: if owner(sid);
      }
      match /events/{id} {
        allow read: if isAdmin();
        allow create: if owner(sid);
      }
      match /inbox/{id} {
        allow read: if isAdmin() || owner(sid);
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (owner(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'done', 'doneAt']));
      }
    }
  }
}
